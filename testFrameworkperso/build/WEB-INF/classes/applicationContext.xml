<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd
           http://www.springframework.org/schema/context
           http://www.springframework.org/schema/context/spring-context.xsd">

    <context:component-scan base-package="service,utils,repository,model,controller" />
 
    <bean id="database" class="utils.Database">
        <property name="url" value="#{systemEnvironment['DB_URL'] ?: 'jdbc:mysql://mysql:3306/testframework?useSSL=false&amp;allowPublicKeyRetrieval=true'}" />
        <property name="username" value="#{systemEnvironment['DB_USER'] ?: 'root'}" />
        <property name="password" value="#{systemEnvironment['DB_PASSWORD'] ?: ''}" />
    </bean>

</beans>